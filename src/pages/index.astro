---
import BaseLayout from "../components/Layout/BaseLayout.astro";
import { projects } from "../data/projects";

const currentDate = new Date();
const formatDate = (date: string) => {
  return new Date(date).toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
  });
};
---

<BaseLayout title="Home" currentPage="/">
  <main class="content text-[#7d7d7d] text-[14px] leading-[24px] py-[3vh_0_6vh] font-medium text-left min-h-[calc(100svh-195px)] h-fit mx-auto max-w-[83.33%]">
    <div class="animate-fadeIn">
      <figure class="avatar-round w-[80%] h-[80%] max-w-[102px] max-h-[102px] my-[15px_auto_1rem]">
        <img src="/julian-berger.webp" alt="Avatar" class="w-full h-full rounded-[50%]" />
      </figure>

      <h1 class="text-[2em] font-extrabold text-[#333]">Julian Berger</h1>

      <p class="mb-6">
        I'm a developer and designer with a passion for building thoughtful, well-designed products and experiences. Whether it's through apps, visual storytelling, or anything in between, I aim to create work that's both functional and visually compelling.
      </p>

      <h2 class="text-[1.7em] text-[#7d7d7d] font-normal mb-6">Work</h2>

      <div class="cv">
        {projects.map((project) => (
          <div class="small-project mb-5">
            <a class="small-project-info flex w-[90%] mx-auto justify-between items-center" href={project.projecturl}>
              <h3 class="text-[1.1em] text-[#333] font-semibold m-0">{project.title}</h3>
              <aside class="text-[#7d7d7d] font-medium text-right transition-all duration-200">
                <time datetime={project.date}>
                  {formatDate(project.date)} - Present
                </time>
              </aside>
            </a>
          </div>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  
  .animate-fadeIn {
    animation: fadeIn 2s ease-out;
  }
</style>
