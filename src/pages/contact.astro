---
import BaseLayout from "../components/Layout/BaseLayout.astro";
---

<BaseLayout title="Contact" currentPage="/contact/">
  <main class="content text-[#7d7d7d] text-[14px] leading-[24px] py-[3vh_0_6vh] font-medium text-left min-h-[calc(100svh-195px)] h-fit mx-auto max-w-[83.33%]">
    <div class="animate-fadeIn">
      <h1 class="text-[2em] font-extrabold text-[#333]">Contact me</h1>
      
      <div class="mail-bg inline-block bg-[#d6d6d6] h-[5px] transition-all duration-150 mt-[4rem] mb-[4.5rem] hover:h-[calc(0.5em+0.7vw)]">
        <a href="mailto:hi@julianberger.me" class="text-[calc(1em+0.875vw)] text-[#000000] block py-2">
          hi@julianberger.me
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  
  .animate-fadeIn {
    animation: fadeIn 1.5s ease-out;
  }
</style>
